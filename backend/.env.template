# ─── VulnPen — Dynamic Configuration ──────────────────────────
# This file is read and written at runtime by the backend API.
# Changes take effect immediately (no restart needed).
# Generated by run.sh — also editable via the Settings UI.

# ── SSH / Exploit Box ──
# `kali` is the built-in attack box that ships with the Docker stack: the
# backend reaches it by service name over the internal `control` network.
# Leave it as-is for a normal install. Point it at an IP/hostname only when you
# want an external exploit box instead — that switches the stack to the base
# compose file, because the built-in box is then unused.
SSH_HOST=kali
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PASSPHRASE=
KALI_ROOT_PASSWORD=

# ── Anthropic OAuth (populated automatically when connecting Claude account) ──
ANTHROPIC_OAUTH_ACCESS_TOKEN=
ANTHROPIC_OAUTH_REFRESH_TOKEN=
ANTHROPIC_OAUTH_EXPIRES_AT=

# ── VNC / GUI (configurable via Settings > GUI) ──
VNC_MODE=
VNC_HOST=
VNC_PORT=9020
VNC_PASSWORD=
VNC_SETUP_DONE=false
VNC_BASE_URL=
VNC_DISPLAY=:89
VNC_RFBPORT=5989
WEBSOCKIFY_PORT=9020

# ── Burp Suite Integration (configurable via Settings > Burp) ──
BURP_RPC_HOST=
BURP_RPC_PORT=50051

# ── Magnitude Browser Agent (configurable via Settings > Browser Agent) ──
MAGNITUDE_ENABLED=false
# Only applies to a local launch (BROWSER_AGENT_REMOTE=false). The browser on
# the attack box is always headful, because the operator watches and can take
# over that same desktop over noVNC.
MAGNITUDE_HEADLESS=false
# Where the browser sends its traffic. The browser runs on the attack box, so
# this is addressed the way THAT box reaches the proxy: `http://kali:8080` (or
# `localhost`, or this box's SSH host) is rewritten to 127.0.0.1:8080 for it,
# and anything else — an external proxy — is passed through unchanged. Leave
# empty to send traffic directly.
MAGNITUDE_PROXY_URL=
# The X display the browser draws on WHEN IT RUNS LOCALLY
# (BROWSER_AGENT_REMOTE=false). It names a display on the backend — its Xvfb is
# :99. It is deliberately NOT used for the remote browser: the attack box has no
# X server there, and pointing it at this value makes Chromium exit at once with
# "Missing X server or $DISPLAY". See BROWSER_AGENT_DISPLAY below.
MAGNITUDE_DISPLAY=:99

# ── Browser Agent placement ──
# The browser runs on the attack box by default, so it shares that container's
# route to the target: the VPN connected there. The backend launches it over SSH
# and drives it over CDP through a loopback-only tunnel; nothing is published on
# a network.
# Set to false to launch Chromium beside the backend instead — only useful when
# there is no attack box, and it cannot reach a target that only the attack box
# can see.
BROWSER_AGENT_REMOTE=true
# The CDP port Chromium listens on, on the attack box. Loopback there, so the
# only way to reach it is the SSH tunnel the backend opens.
BROWSER_AGENT_CDP_PORT=9222
# Where the remote browser keeps its profile. Deliberately inside /kali-data,
# which is bind-mounted into BOTH containers, so Burp's CA can be installed into
# this profile's trust store from the backend without an SSH round-trip.
BROWSER_AGENT_PROFILE_DIR=/kali-data/chromium-home
# The display the REMOTE Chromium draws on — the attack box's own desktop, which
# is what the GUI page shows over noVNC. Defaults to :89, the display the attack
# box's entrypoint starts. Only change it if you run the attack box's desktop
# somewhere else.
BROWSER_AGENT_DISPLAY=:89

# ── AWS Bedrock (add the API key per-model in Settings > Models) ──
# Bedrock's endpoint is region-specific. This sets the region used when a model
# preset leaves Base URL blank; an explicit Base URL on the preset always wins.
# Defaults to us-east-1.
BEDROCK_REGION=

# ── Registration ──
# New accounts are allowed by default so a team can onboard itself. Set to false
# to close registration once the accounts you need exist. The very first account
# is always allowed, so a fresh installation can still create its owner.
ALLOW_REGISTRATION=true

# ── Browser Agent timeouts ──
# Milliseconds one browser_action run may hold the browser before the run is
# treated as hung and the browser is discarded (the next call starts a fresh
# one). Kept below the browser_action tool's own 120s cap so the run reports
# the real reason instead of a bare timeout. Set to 0 to wait forever, which
# reinstates the hang this guard exists to prevent — so 0 is not a safe value.
BROWSER_AGENT_RUN_TIMEOUT_MS=90000
# Milliseconds the browser may sit idle before it is released. Set to 0 to
# disable the idle release entirely.
BROWSER_AGENT_IDLE_TIMEOUT_MS=600000

# ── Browser Agent desktop ports (keep in sync with backend/entrypoint.sh) ──
# The browser agent runs its own VNC stack, separate from the Kali GUI stack
# configured as VNC_RFBPORT above. These are the backend's own ports for that
# agent display, NOT the host-published bridge to the attack box's desktop
# (that is BROWSER_AGENT_DESKTOP_PORT). Change them only if you moved it.
BROWSER_AGENT_VNC_RFB_PORT=5999
BROWSER_AGENT_NOVNC_PORT=6080

# ── Report rendering ──
# LibreOffice binary used to render .docx reports. Leave empty to let the
# backend search the usual locations, including /usr/bin/soffice.
LIBREOFFICE_PATH=

# ── LLM proxy target allowlist ──
# Comma-separated hostnames the model proxy may forward to even when they are
# not public infrastructure — for a self-hosted or in-cluster model endpoint.
# An entry matches the host exactly or as a suffix ("corp.internal" also
# allows "llm.corp.internal"). Every other target must resolve to a public
# address, so private and loopback targets are refused. Empty by default.
LLM_PROXY_ALLOWED_HOSTS=

# ── Langfuse tracing (optional, off by default) ──
# All three are required: tracing starts only when LANGFUSE_ENABLED is exactly
# "true" AND both keys are set. Keys come from your Langfuse project.
LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

